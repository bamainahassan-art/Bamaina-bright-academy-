# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ACADEMY_SESSION_SECRET: Optional signing secret for local portal credentials.
ACADEMY_SESSION_SECRET=

# PAYSTACK_SECRET_KEY: Optional server-side Paystack secret key if online payments are enabled.
PAYSTACK_SECRET_KEY=

# PAYSTACK_PUBLIC_KEY: Optional Paystack public key if online payments are enabled.
PAYSTACK_PUBLIC_KEY=
